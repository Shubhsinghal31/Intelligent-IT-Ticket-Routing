# ============================================
# Application
# ============================================
APP_NAME=helpdesk-ai
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# ============================================
# FastAPI Server
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Database (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk_ai
DB_USER=postgres
DB_PASSWORD=change_me_in_real_env

# Full URL form (used by SQLAlchemy)
DATABASE_URL=postgresql://postgres:change_me_in_real_env@localhost:5432/helpdesk_ai

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET_KEY=replace_with_long_random_string_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# ============================================
# ML Models
# ============================================
ML_MODEL_PATH=ml/models/
ML_PRIORITY_MODEL=priority_classifier.pkl
ML_DEPARTMENT_MODEL=department_classifier.pkl
ML_SLA_MODEL=sla_predictor.pkl

# ============================================
# Frontend
# ============================================
FRONTEND_URL=http://localhost:8501
API_BASE_URL=http://localhost:8000

# Comma-separated list, not JSON (see backend/core/config.py's
# cors_origins_list property for why). Uncomment to override the default
# of "http://localhost:8501,http://127.0.0.1:8501" — e.g. for multiple
# allowed origins: CORS_ORIGINS=https://a.example.com,https://b.example.com
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# How long the frontend waits for a backend response before giving up.
# Raise this in production if the backend can cold-start (e.g. Render's
# free tier spins services down after ~15 min idle and takes 30-60s to
# wake back up) — a request during that window shouldn't be misreported
# as "backend is down". Leave unset locally; 10s is plenty for a backend
# that's already running.
# API_TIMEOUT_SECONDS=60

# ============================================
# Outbound email (Forgot Password)
# ============================================
# Leave SMTP_HOST empty for local dev — reset emails are logged to the
# console instead of sent (see backend/core/email.py). Fill these in
# for a real deployment (e.g. Gmail with an App Password, SendGrid,
# Mailgun's SMTP relay, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@helpdesk-ai.local
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_FORGOT_PASSWORD=3/minute